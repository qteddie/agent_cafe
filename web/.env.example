# Copy this file to web/.env and fill it in. Make each key with:
#   openssl rand -hex 24

# The key every session's reports carry: the same as "key" in the plugin's web.json.
CAFE_INGEST_KEY=

# The password for the page: a different key from the one above.
CAFE_VIEW_KEY=

# The time zone times of day are shown in.
TZ=Asia/Taipei

# Only with --profile tunnel: the token of the Cloudflare tunnel that serves your domain.
CLOUDFLARE_TUNNEL_TOKEN=
