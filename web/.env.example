# Copy this file to web/.env and fill it in. Make each key with:
#   openssl rand -hex 24

# The key every session's reports carry: the plugin's web_key setting (or "key" in web.json).
CAFE_INGEST_KEY=

# The password for the page: a different key from the one above.
CAFE_VIEW_KEY=

# The time zone times of day are shown in, e.g. America/New_York, Europe/London, Asia/Taipei.
TZ=UTC

# Set to 1 to log every report that comes in (docker compose logs -f cafe).
CAFE_DEBUG=

# The port the page takes on this machine: http://localhost:8080. Change it when
# something here already has that port ("port is already allocated" when you
# start). The tunnel does not come in this way: its service URL stays
# http://cafe:8080 whatever this is.
CAFE_PORT=8080

# Only with --profile tunnel: the token of the Cloudflare tunnel that serves your
# domain. It is the long string after --token in the Docker command Cloudflare
# shows for the tunnel (that command itself need not be run: compose.yaml runs
# the same image). The tunnel's route there gives your hostname the service URL
# http://cafe:8080.
CLOUDFLARE_TUNNEL_TOKEN=
